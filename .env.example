KIWIKI_DATA_DIR=/data
KIWIKI_USERS=admin:<admin-api-key>:admin,writer:<writer-api-key>:write,reader:<reader-api-key>:read
KIWIKI_BASE_URL=http://localhost:8080
KIWIKI_OAUTH_TOKEN_SECRET=<random-token-signing-secret>
KIWIKI_TRUST_PROXY=false
KIWIKI_SESSION_TTL_SECONDS=2592000
# Nur setzen, wenn KIWIKI_TRUST_PROXY=true ist. Beispiel fuer Docker-Netze:
# KIWIKI_TRUSTED_PROXY_CIDRS=172.16.0.0/12
KIWIKI_CORS_ORIGINS=
# Rate-Limiting global abschalten (nur fuer Tests/diagnose):
# KIWIKI_RATE_LIMIT_ENABLED=false
# Fehlversuche der API-Key-Eingabe, von /login und /oauth/authorize geteilt
# (Defaults in Klammern). Das globale Budget begrenzt die Summe ueber alle
# Quellen, damit verteiltes Durchprobieren hinter NAT/VPN/Tor teuer wird:
# KIWIKI_KEY_ATTEMPT_LIMIT=5
# KIWIKI_KEY_ATTEMPT_GLOBAL_LIMIT=30
# KIWIKI_KEY_ATTEMPT_WINDOW_SECONDS=60
# Speicher der Fehlversuchs-Zaehler. "memory" zaehlt prozesslokal und ist nur
# fuer eine Replika gueltig; "sqlite" teilt den Stand ueber ein RWX-Volume:
# KIWIKI_RATE_LIMIT_STORE=memory
# KIWIKI_RATE_LIMIT_STORE_PATH=/data/.kiwiki/ratelimit.sqlite
KIWIKI_LOG_LEVEL=INFO
KIWIKI_UI_LIMIT=240
# Grenzen je Benutzer-Workspace (Defaults in Klammern):
# KIWIKI_MAX_TENANT_FILES=10000
# KIWIKI_MAX_TENANT_BYTES=1073741824
# KIWIKI_MAX_LIST_ITEMS=1000
# KIWIKI_MAX_RECURSIVE_LIST_ITEMS=10000
# Optionaler, pro Benutzer getrennter Wissensindex. Markdown bleibt Source of Truth.
KIWIKI_KNOWLEDGE_ENABLED=false
KIWIKI_KNOWLEDGE_BACKFILL_BATCH_SIZE=25
KIWIKI_KNOWLEDGE_MAX_FILE_BYTES=1048576
KIWIKI_KNOWLEDGE_MAX_DB_BYTES=134217728
# Freier Speicher auf dem Workspace-Volume, unterhalb dessen der Indexer nicht schreibt:
# KIWIKI_KNOWLEDGE_MIN_FREE_BYTES=134217728
# Kapazitaetsgrenzen der MCP-Laufzeitzustaende (Defaults in Klammern):
# KIWIKI_MCP_MAX_SSE_SESSIONS=128
# KIWIKI_MCP_SSE_QUEUE_MAX_MESSAGES=100
# KIWIKI_MCP_UPLOAD_TTL_SECONDS=3600
# KIWIKI_MCP_MAX_UPLOAD_BYTES=10485760
# KIWIKI_MCP_MAX_UPLOAD_CHUNKS=1000
# KIWIKI_MCP_MAX_STAGED_UPLOADS=32
# KIWIKI_MCP_MAX_STAGED_BYTES=52428800
# OAuth-Laufzeitgrenzen (Defaults in Klammern):
# KIWIKI_OAUTH_TOKEN_TTL_SECONDS=86400
# KIWIKI_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# KIWIKI_OAUTH_CLIENT_TTL_SECONDS=86400
# KIWIKI_OAUTH_MAX_CODES=256
# KIWIKI_OAUTH_MAX_CLIENTS=128
# KIWIKI_OAUTH_MAX_REDIRECT_URIS=10
# KIWIKI_OAUTH_LIMIT=20
# Vollstaendige Liste mit Defaults und Beschreibung: README.md, Abschnitt Configuration.
